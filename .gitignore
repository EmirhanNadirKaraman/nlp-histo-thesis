histopathology_papers/
# Corpus inputs stay local — 5.2 GB of PDFs/XMLs, most under licences that do not permit
# redistribution (322 of 1093 carry no CC licence at all). target_pmc_ids.txt is the
# exception: it is 16 KB of accession numbers — the corpus *definition*, not its content —
# and without it `acquire` cannot know which papers to fetch, so a clean clone cannot
# rebuild anything.
# NOTE: the pattern must be `files/*`, not `files/` — git cannot re-include a file whose
# parent *directory* is excluded, so the negation below would silently do nothing.
files/*
!files/target_pmc_ids.txt

.DS_STORE
.claude/
/pdffigures2/
# `out/*` not `out/`: a bare `out/` makes git refuse to descend, so the negations below
# would never be reconsidered. Ignoring the *contents* lets the re-includes take effect.
out/*
# …except the frozen chapter-9 reference CSVs — the golden output that `replay chapter9`
# is diffed against (REPRODUCE.md Step 7). Only the CSVs are reproducible byte-for-byte;
# the JSONs/manifest carry run metadata, and the .BACKUP_ sibling is a local copy, so both
# stay ignored. Re-include the path one level at a time (git will not descend into an
# ignored directory otherwise), then narrow to *.csv.
!out/thesis_results/
out/thesis_results/*
!out/thesis_results/chapter9_offline_replay/
out/thesis_results/chapter9_offline_replay/*
!out/thesis_results/chapter9_offline_replay/*.csv
profile.prof
umls_entities/
umls_texts/
relevant_texts/
legacy/langchain-summarization/summarization_results/
disease_entities/
named_entity_recognition/entity_linking_cache.json

eval/out/
eval/pdfs/
eval/data/*
# E13: the validated relation-classification eval set + its calibration/evaluation
# splits are committed (results depend on them); raw batches, API request/result
# intermediates, and everything else under eval/data/ stay ignored.
!eval/data/relation_claim_pairs_300.jsonl
!eval/data/relation_claim_pairs_300.meta.json
!eval/data/relation_claim_pairs_calibration.jsonl
!eval/data/relation_claim_pairs_evaluation.jsonl
# E14 (REPRODUCE.md Step 8) heldout15 inputs — committed to git rather than shipped in the
# replay bundle (B-123): they gzip to ~1 MB and this way a clean clone can run E14 with no
# extra download. Track ONLY the clean voter_cache.json — the sibling
# voter_cache.contaminated.json is a leakage variant that must never ship, and primer.json
# is unused. So re-include the directory, re-ignore its contents, then narrow to one file.
!eval/data/silver_findings_heldout15.jsonl
!eval/data/map_primer_heldout15/
eval/data/map_primer_heldout15/*
!eval/data/map_primer_heldout15/voter_cache.json
# Per-experiment report artifacts (E01…E14, corpus_stats, old_reports, …) stay local:
# they are regenerable outputs, not sources. RESULTS.md is the exception — it is the
# documented experiment record, cited by .claude/CLAUDE.md alongside eval/README.md and
# eval/EXPERIMENTS.md (both already tracked), so it is committed with them.
# NOTE: the pattern must be `eval/reports/*`, not `eval/reports/` — git cannot re-include
# a file whose parent *directory* is excluded, so the negation below would silently fail.
eval/reports/*
!eval/reports/RESULTS.md

# E13: generated per-batch prompt files (template lives in prepare_manual_batches.py)
eval/prompts/relation_pairs/*_prompt.txt

# Phase 1 eval-harness outputs (keep eval/results/.gitkeep)
eval/results/*.csv
eval/results/*.json
